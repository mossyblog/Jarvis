{
  "hooks": {
    "post-edit": {
      "description": "Run linter after editing TypeScript/TSX files",
      "enabled": true,
      "commands": [
        {
          "description": "Run ESLint on TypeScript files",
          "match": "**/*.{ts,tsx}",
          "command": "npm run lint",
          "on_error": "warn",
          "timeout": 30000
        }
      ]
    },
    "post-write": {
      "description": "Run linter after creating TypeScript/TSX files",
      "enabled": true,
      "commands": [
        {
          "description": "Run ESLint on new TypeScript files",
          "match": "**/*.{ts,tsx}",
          "command": "npm run lint",
          "on_error": "warn",
          "timeout": 30000
        }
      ]
    },
    "post-multi-edit": {
      "description": "Run linter after multi-editing TypeScript/TSX files",
      "enabled": true,
      "commands": [
        {
          "description": "Run ESLint after multiple edits",
          "match": "**/*.{ts,tsx}",
          "command": "npm run lint",
          "on_error": "warn",
          "timeout": 30000
        }
      ]
    }
  },
  "settings": {
    "show_output": true,
    "fail_on_error": false,
    "parallel_execution": false
  }
}