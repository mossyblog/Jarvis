{
  "protection": {
    "required_status_checks": {
      "strict": true,
      "contexts": [
        "Code Quality & Linting",
        "Unit Tests & Coverage",
        "Build Application", 
        "E2E Tests (chromium)",
        "E2E Tests (firefox)",
        "E2E Tests (webkit)",
        "Mobile E2E Tests",
        "Accessibility Tests",
        "Performance Tests",
        "Visual Regression Tests",
        "Test Summary & Reports"
      ]
    },
    "enforce_admins": false,
    "required_pull_request_reviews": {
      "required_approving_review_count": 1,
      "dismiss_stale_reviews": true,
      "require_code_owner_reviews": true,
      "require_last_push_approval": false
    },
    "restrictions": null,
    "allow_force_pushes": false,
    "allow_deletions": false,
    "block_creations": false,
    "required_conversation_resolution": true
  },
  "quality_gates": {
    "coverage_threshold": 80,
    "performance_score_threshold": 85,
    "accessibility_violations_max": 0,
    "bundle_size_checks": true,
    "security_scan_required": true
  },
  "deployment_gates": {
    "staging": {
      "required_checks": [
        "unit-tests",
        "e2e-tests",
        "accessibility-tests",
        "performance-tests"
      ],
      "manual_approval": false
    },
    "production": {
      "required_checks": [
        "unit-tests",
        "e2e-tests", 
        "accessibility-tests",
        "performance-tests",
        "visual-regression-tests",
        "security-scan"
      ],
      "manual_approval": true,
      "require_up_to_date_branch": true
    }
  },
  "auto_merge": {
    "enabled": false,
    "conditions": [
      "all_checks_pass",
      "approved_review",
      "no_requested_changes",
      "branch_up_to_date"
    ]
  }
}