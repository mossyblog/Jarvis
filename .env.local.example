# Environment configuration template for local development
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to source control

# JWT Configuration
Jwt__SecretKey=CHANGE_ME_TO_A_SECURE_256_BIT_KEY_AT_LEAST_32_CHARS_LONG
Jwt__Issuer=jarvis-api
Jwt__Audience=jarvis-clients

# Database Configuration
ConnectionStrings__JarvisDb=Host=localhost;Port=5432;Database=jarvis;Username=postgres;Password=CHANGE_ME

# Optional: Override default token expiration times
# Jwt__AccessTokenExpirationMinutes=15
# Jwt__RefreshTokenExpirationDays=30