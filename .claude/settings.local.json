{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(ls:*)",
      "Bash(dotnet build)",
      "Bash(dotnet test:*)",
      "Bash(pwsh:*)",
      "Bash(powershell:*)",
      "Bash(/mnt/c/Program Files/dotnet/dotnet.exe build)",
      "Bash(/mnt/c/Program Files/dotnet/dotnet.exe test core.jarvis.data.tests --verbosity normal)",
      "Bash(/mnt/c/Program Files/dotnet/dotnet.exe test core.jarvis.data.tests --filter \"DateTimeProperties_WithAtSuffix_MapCorrectly\" --verbosity normal)",
      "Bash(/mnt/c/Program Files/dotnet/dotnet.exe test core.jarvis.data.tests --filter \"DateTimeProperties_WithAtSuffix_MapCorrectly\" --verbosity quiet)",
      "Bash(/mnt/c/Program Files/dotnet/dotnet.exe test core.jarvis.data.tests --verbosity quiet)",
      "Bash(/mnt/c/Program Files/dotnet/dotnet.exe test core.jarvis.tests --verbosity quiet)",
      "Bash(/mnt/c/Program Files/dotnet/dotnet.exe test core.jarvis.api.tests --verbosity quiet)",
      "Bash(/mnt/c/Program Files/dotnet/dotnet.exe test core.jarvis.tests --filter \"ConcurrencyControlIntegrationTests\" --verbosity normal)",
      "Bash(/mnt/c/Program Files/dotnet/dotnet.exe test core.jarvis.tests --filter \"TryCommit_WithMatchingVersion_ShouldSucceedAndIncrementVersion\" --verbosity normal)",
      "Bash(/mnt/c/Program Files/dotnet/dotnet.exe test core.jarvis.api.tests --filter \"Authenticate_Should_Generate_Small_Tokens\" --verbosity normal)",
      "Bash(timeout:*)",
      "WebFetch(domain:www.postgresql.org)",
      "Bash(dotnet build:*)",
      "Bash(rg:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:tweakcn.com)",
      "Bash(docker exec:*)",
      "Bash(docker-compose down:*)",
      "Bash(docker-compose up:*)",
      "Bash(docker-compose logs:*)",
      "Bash(sudo mv:*)",
      "mcp__shadcn-ui__list_components",
      "mcp__playwright__browser_navigate",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)"
    ],
    "deny": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if ls *.tsx 2>/dev/null >/dev/null || find . -name '*.tsx' -type f 2>/dev/null | head -1 | grep -q .; then npm run lint --silent 2>/dev/null || echo 'Lint check completed'; fi",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "outputStyle": "Explanatory"
}
